# Edge site configuration. Copy to deploy/.env and fill in per-site values.
# docker compose reads deploy/.env automatically when using -f deploy/docker-compose.edge.yml.

# --- Image / update channel ---
# Registry path of the published collector image, and the tag Watchtower tracks.
# Use a moving tag (latest, or a channel like stable) so pushing a new build
# triggers an update. Pin to an exact version tag to freeze this site.
COLLECTOR_IMAGE=ghcr.io/OWNER/sdc-collector
COLLECTOR_TAG=latest

# Only needed for a private registry.
REGISTRY_USER=
REGISTRY_PASSWORD=

# Registry poll interval in seconds.
WATCHTOWER_POLL_INTERVAL=300

# --- Collector runtime (see collector/src/collector/config.py) ---
# Required.
OPC_ENDPOINT_URL=opc.tcp://opcua-gateway.local:4840
CLOUD_API_BASE_URL=https://cloud-api.example.com
COLLECTOR_PLC_IDS=PLC-01,PLC-02,PLC-03,PLC-04,PLC-05,PLC-06,PLC-07,PLC-08,PLC-09,PLC-10

# Optional — defaults shown.
GATEWAY_HEARTBEAT_TIMEOUT_S=15.0
TAG_CONFIG_POLL_INTERVAL_S=60.0
TRANSMIT_INTERVAL_S=2.0
TRANSMIT_BATCH_MAX=500
